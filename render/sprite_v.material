name: "sprite_v"
tags: "tile"
vertex_program: "/render/sprite_v.vp"
fragment_program: "/render/sprite_v.fp"
vertex_space: VERTEX_SPACE_WORLD
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR_MIPMAP_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
  max_anisotropy: 0.0
}
attributes {
  name: "tint_v"
  semantic_type: SEMANTIC_TYPE_NONE
  data_type: TYPE_FLOAT
  normalize: false
  coordinate_space: COORDINATE_SPACE_LOCAL
  double_values {
    v: 1.0
    v: 1.0
    v: 1.0
    v: 1.0
  }
  vector_type: VECTOR_TYPE_VEC4
}
